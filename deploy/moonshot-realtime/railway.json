{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pip install -e ."
  },
  "deploy": {
    "startCommand": "python -m wallet500.moonshot_realtime_stream",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS"
  }
}
