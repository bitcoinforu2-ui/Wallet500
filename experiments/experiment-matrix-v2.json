{
  "experiment_id": "W500-EXP-V2-SURVIVAL-ALPHA",
  "status": "ACTIVE",
  "mode": "PAPER_ONLY_REAL_DATA_EXACT_PAIR",
  "objective": "Identify which pre-entry filters produce survivable, tradable alpha instead of short-lived volume pumps.",
  "control": {
    "name": "E1_LEGACY_TOP10",
    "status": "FAILED_BASELINE_FROZEN",
    "mutable": false
  },
  "global_rules": {
    "paper_entry_usd": 1,
    "exact_pair_required": true,
    "minimum_liquidity_usd": 50000,
    "never_delete_failures": true,
    "immutable_discovery_snapshot": true,
    "same_candidate_feed_for_all_arms": true,
    "no_mid_experiment_threshold_changes": true,
    "target_sample_per_arm": 50,
    "minimum_evaluation_sample_per_arm": 30
  },
  "arms": [
    {
      "id": "A",
      "name": "SURVIVAL_LP",
      "requires": ["exact_pair", "liquidity>=50000", "lp_security_verified", "pair_survival_verified"]
    },
    {
      "id": "B",
      "name": "TIME_SURVIVAL",
      "requires": ["exact_pair", "liquidity>=50000", "minimum_survival_time", "liquidity_retention"]
    },
    {
      "id": "C",
      "name": "SMART_MONEY_CONFIRMATION",
      "requires": ["exact_pair", "liquidity>=50000", "verified_wallet_evidence", "holder_cluster_check"]
    },
    {
      "id": "D",
      "name": "COMBINED_STRICT",
      "requires": ["exact_pair", "liquidity>=50000", "lp_security_verified", "pair_survival_verified", "minimum_survival_time", "liquidity_retention", "verified_wallet_evidence", "holder_cluster_check"]
    }
  ],
  "metrics": [
    "survival_rate",
    "verified_tradable_rate",
    "roi",
    "max_drawdown",
    "false_positive_rate",
    "liquidity_retention",
    "time_to_failure",
    "precision"
  ],
  "classification_rules": {
    "live": "exact_pair && current_liquidity_usd>=50000 && required_arm_checks_pass",
    "failed_survival": "previously_entered && (current_liquidity_usd<50000 || pair_survival_failed)",
    "pending_research": "required_security_or_cluster_evidence_unresolved"
  }
}
