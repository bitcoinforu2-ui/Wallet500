FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    COPY_DAEMON=true \
    COPY_POLL_SECONDS=5

COPY pyproject.toml ./
COPY src ./src
COPY experiments ./experiments
RUN pip install --no-cache-dir '.[copytrading]'

# Live mode must mount /app/data on durable storage. Losing this ledger means
# losing position/exit state, so do not run a funded wallet on ephemeral storage.
VOLUME ["/app/data"]

CMD ["python", "-m", "wallet500.cryptoyeezus_copy"]
